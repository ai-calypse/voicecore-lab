# Copy to .env (gitignored) only for live providers. Mock mode needs none of these.
# Keys stay on the server: the browser only ever gets a 60 s gateway token.
DEEPGRAM_API_KEY=      # speech-to-text and (by default) text-to-speech
OPENROUTER_API_KEY=
CARTESIA_API_KEY=      # only for --tts cartesia
# Optional: a fixed secret for gateway tokens (otherwise random per process).
GATEWAY_SECRET=
