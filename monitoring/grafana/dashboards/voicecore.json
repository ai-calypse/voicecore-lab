  {
   "type": "row",
   "title": "Alerts and logs",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 45
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Firing alerts (Watchdog always fires)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 10,
    "w": 8,
    "x": 0,
    "y": 46
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "ALERTS{alertstate=\"firing\"}",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "alertstate": true
      },
      "renameByName": {
       "alertname": "alert"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "None firing"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "type": "logs",
   "title": "Logs (filter with the session_id box above)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 10,
    "w": 16,
    "x": 8,
    "y": 46
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "refId": "A",
     "expr": "{stack=\"voicecore\", service=~\"agent-core|gateway\"} |= \"$session_id\""
    }
   ]
  }
 ]
