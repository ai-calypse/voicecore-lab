  {
   "type": "gauge",
   "title": "Spend (USD) of the 5 USD cap",
   "description": "from the ledger; alert at 80%",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 28
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "min": 0,
