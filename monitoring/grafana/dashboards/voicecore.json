{
 "uid": "voicecore",
 "title": "VoiceCore",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "voicecore"
 ],
 "templating": {
  "list": [
   {
    "type": "textbox",
    "name": "session_id",
    "label": "session_id",
    "query": "",
    "current": {
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Latency (server side, orchestrator clock)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Endpoint to first audio",
   "description": "voicecore/stages.py; target p95 < 1,200 ms (docs/ops/slos.md). The line is the target.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1200
       }
      ]
     },
     "noValue": "No voice turns in range (typed turns have no endpoint)"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(voicecore_stage_ms_bucket{stage=\"endpoint_to_first_audio\"}[5m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(voicecore_stage_ms_bucket{stage=\"endpoint_to_first_audio\"}[5m])))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Stage p95 by stage",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "off"
