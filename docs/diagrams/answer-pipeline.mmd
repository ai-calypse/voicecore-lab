graph LR
  P[Docs pages] --> I["Ingest<br/>SSRF guard, host allow-list"]
  I -->|"flag instruction-like text"| IX[("Index<br/>SQLite FTS5 + bge-small vectors")]
  Q([Question]) --> K[Keyword search]
  Q --> V[Vector search]
  IX --> K
  IX --> V
  K --> RRF[Reciprocal rank fusion]
  V --> RRF
  RRF -->|"official pages only,<br/>flagged passages never quoted"| PR[Grounded prompt]
